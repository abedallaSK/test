# ---- Strapi connection (REQUIRED) ----
# Base origin of the Strapi backend. "/api" is appended automatically, so a
# trailing "/api" or "/" here is fine too.
STRAPI_API_URL=https://api.dojospaces.com
# API token with: read Users + Dojo, create Activity, create + update
# Activity_Member. A Full-access token satisfies all of these.
STRAPI_TOKEN=your-strapi-api-token

# ---- Server ----
# Railway injects PORT automatically; only set this for local runs.
PORT=3000

# ---- Authentication (REQUIRED) ----
# Username and password to access the UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# ---- Default config (seeds the in-memory config on boot; editable in the UI) ----
ENABLED=false
# Standard 5-field cron. Runs in Asia/Jerusalem time. Example: every 30 minutes.
DEFAULT_CRON=*/30 * * * *
DEFAULT_DURATION_MINUTES=30
DEFAULT_MIN_MEMBERS=1
DEFAULT_MAX_MEMBERS=3
# Number of activities to create per run (random between min and max)
DEFAULT_MIN_ACTIVITIES=1
DEFAULT_MAX_ACTIVITIES=1
# One of: EVENT, CLASS, CUSTOM
DEFAULT_ACTIVITY_TYPE=CUSTOM
AUTO_END=true
ATTACH_DOJO=true
# Turn off to generate events only (no activities)
ACTIVITIES_ENABLED=true

# ---- Events (created in the SAME run as activities, sharing the user pool) ----
EVENTS_ENABLED=false
# How many events to create per run (random between min and max)
DEFAULT_MIN_EVENTS=1
DEFAULT_MAX_EVENTS=2
# Percent of events created with isEvent=true (the rest are false)
DEFAULT_EVENT_IS_EVENT_RATIO=50
# startTime is placed this many days in the future (random in the window)
DEFAULT_EVENT_FUTURE_MIN_DAYS=1
DEFAULT_EVENT_FUTURE_MAX_DAYS=30
# endTime = startTime + this many minutes
DEFAULT_EVENT_DURATION_MINUTES=120
# Upload a placeholder photo (picsum.photos) and attach it to each event
EVENT_ATTACH_PHOTO=true
EVENT_ATTACH_DOJO=true
# Optional: override the default title/description pools (one entry per line).
# Leave unset to use the built-in defaults. Newlines are hard to express in a
# single-line .env var, so prefer editing these in the UI's Events tab.
# DEFAULT_EVENT_TITLES=
# DEFAULT_EVENT_DESCRIPTIONS=
