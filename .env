# ---- Strapi connection (REQUIRED) ----
# Base origin of the Strapi backend. "/api" is appended automatically, so a
# trailing "/api" or "/" here is fine too.
STRAPI_API_URL=https://api.dojospaces.com
# API token with: read Users + Dojo, create Activity, create + update
# Activity_Member. A Full-access token satisfies all of these.
STRAPI_TOKEN=3182000d5c9591ea53e163f077e031e1d9d7308cdeec7e78342a4974fa604220f9ee5bfbc31d9fd2dee5767b6a21afb983f591393c91b91f4b558f9396e94eb0df5dc6b7dd1a3449f8aabde48a173ace470934cb3350e2c7efe29144c54afd3b270b5df871c8b6b87b913ef52909c55cb131df08d2b630b28e7728cb88363471
# ---- Server ----
# Railway injects PORT automatically; only set this for local runs.
PORT=3000

# ---- Authentication (REQUIRED) ----
# Username and password to access the UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---- Default config (seeds the in-memory config on boot; editable in the UI) ----
ENABLED=false
# Standard 5-field cron. Runs in Asia/Jerusalem time. Example: every 30 minutes.
DEFAULT_CRON=*/30 * * * *
DEFAULT_DURATION_MINUTES=30
DEFAULT_MIN_MEMBERS=1
DEFAULT_MAX_MEMBERS=3
# Number of activities to create per run (random between min and max)
DEFAULT_MIN_ACTIVITIES=1
DEFAULT_MAX_ACTIVITIES=1
# One of: EVENT, CLASS, CUSTOM
DEFAULT_ACTIVITY_TYPE=CUSTOM
AUTO_END=true
ATTACH_DOJO=true
