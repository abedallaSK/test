# =====================================================================
#  Strapi connection
# =====================================================================
#
# MULTIPLE ENVIRONMENTS (recommended)
# Define every Strapi backend in ONE JSON array. Each entry: name, url, token.
# The UI shows a dropdown to switch between them; each keeps its own schedule,
# user pool, and event settings. Must be valid JSON on a single line.
#
# STRAPI_ENVIRONMENTS=[{"name":"Production","url":"https://api.dojospaces.com","token":"prod-token"},{"name":"Staging","url":"https://staging.dojospaces.com","token":"staging-token"}]

# SINGLE ENVIRONMENT (legacy fallback — used only if STRAPI_ENVIRONMENTS is unset)
# Base origin of the Strapi backend. "/api" is appended automatically.
STRAPI_API_URL=https://api.dojospaces.com
# API token with: read Users + Dojo, create Activity, create + update
# Activity_Member, create Event, upload. A Full-access token satisfies all.
STRAPI_TOKEN=your-strapi-api-token
# Optional name for the single legacy environment (defaults to "Default").
# STRAPI_ENV_NAME=Production

# =====================================================================
#  Server
# =====================================================================
# Railway injects PORT automatically; only set this for local runs.
PORT=3000
# Where settings are persisted (survives restarts). Defaults to ./data.
# Environments added in the UI + all per-env settings are saved here as JSON.
# NOTE: contains Strapi tokens — keep it out of version control (data/ is
# git-ignored). Delete data/state.json to reset everything to these defaults.
# DATA_DIR=./data

# =====================================================================
#  Authentication (REQUIRED) — used to access the settings UI
# =====================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# =====================================================================
#  Default config — seeds EACH environment's in-memory config on boot.
#  Everything below is editable per-environment in the UI.
# =====================================================================

# ---- Activities schedule (independent cron) ----
# Arm the activities cron on boot. (ENABLED is honoured as a legacy fallback.)
ACTIVITIES_SCHEDULE_ENABLED=false
# Standard 5-field cron, Asia/Jerusalem time. Example: every 30 minutes.
DEFAULT_ACTIVITY_CRON=*/30 * * * *
# (Legacy alias for DEFAULT_ACTIVITY_CRON)
# DEFAULT_CRON=*/30 * * * *

# ---- Activity settings ----
DEFAULT_DURATION_MINUTES=30
# Or set an explicit random range:
# DEFAULT_MIN_DURATION_MINUTES=30
# DEFAULT_MAX_DURATION_MINUTES=60
DEFAULT_MIN_MEMBERS=1
DEFAULT_MAX_MEMBERS=3
DEFAULT_MIN_ACTIVITIES=1
DEFAULT_MAX_ACTIVITIES=1
# One of: EVENT, CLASS, CUSTOM
DEFAULT_ACTIVITY_TYPE=CUSTOM
AUTO_END=true
ATTACH_DOJO=true

# ---- Events schedule A: isEvent = true (100% real events) ----
EVENTS_SCHEDULE_ENABLED=false
# Default: every 6 hours.
DEFAULT_EVENT_CRON=0 */6 * * *
DEFAULT_MIN_EVENTS=1
DEFAULT_MAX_EVENTS=2

# ---- Events schedule B: isEvent = false (0% — these show as ACTIVITIES) ----
# There is NO enable env var for schedule B — it starts off; turn it on in the UI.
# Default: every 12 hours.
DEFAULT_EVENT_FALSE_CRON=0 */12 * * *
DEFAULT_MIN_EVENTS_FALSE=1
DEFAULT_MAX_EVENTS_FALSE=1

# ---- Shared event settings (apply to both schedules above) ----
# startTime is placed this many days in the future (random in the window).
DEFAULT_EVENT_FUTURE_MIN_DAYS=1
DEFAULT_EVENT_FUTURE_MAX_DAYS=30
# endTime = startTime + this many minutes.
DEFAULT_EVENT_DURATION_MINUTES=120
EVENT_ATTACH_PHOTO=true
EVENT_ATTACH_DOJO=true
# Optional: override the built-in title/description pools (one entry per line).
# Prefer editing these in the UI's Events tab.
# DEFAULT_EVENT_TITLES=
# DEFAULT_EVENT_DESCRIPTIONS=
